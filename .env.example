# ArenaPredict - ambiente local/Docker
# Integração CS2: token somente no backend. Cadastre a credencial no .env privado.
PANDASCORE_API_TOKEN=
PANDASCORE_VIDEOGAMES=csgo,lol,valorant
SPORTS_SYNC_ENABLED=false
SPORTS_SYNC_PROVIDER=PANDASCORE
SPORTS_SYNC_INTERVAL_MS=30000
SPORTS_SYNC_INITIAL_DELAY_MS=15000
SPORTS_SYNC_UPCOMING_INTERVAL_MS=900000
SPORTS_SYNC_RUNNING_INTERVAL_MS=120000
SPORTS_SYNC_FINISHED_INTERVAL_MS=300000
SPORTS_SYNC_TRACKED_INTERVAL_MS=120000
SPORTS_SYNC_NEAR_START_MINUTES=30
SPORTS_SYNC_UPCOMING_DAYS=7
SPORTS_SYNC_CORRECTION_WINDOW_HOURS=72
SPORTS_SYNC_TRACKED_BATCH_SIZE=20
SPORTS_SYNC_LEASE_MS=900000
# Habilite somente se o plano/payload fornecer placar de série ao vivo confiável.
PANDASCORE_LIVE_SCORES_ENABLED=false
PANDASCORE_CONNECT_TIMEOUT_MS=3000
PANDASCORE_READ_TIMEOUT_MS=8000
PANDASCORE_MAX_RETRIES=1
PANDASCORE_RETRY_BACKOFF_MS=500
PANDASCORE_FAILURE_BACKOFF_MS=60000
PANDASCORE_RATE_LIMIT_BACKOFF_MS=3600000
PANDASCORE_MAX_REQUESTS_PER_HOUR=600
PANDASCORE_REMAINING_RESERVE=20
PANDASCORE_MAX_PAGES=3
PANDASCORE_PAGE_SIZE=100
PANDASCORE_REFERENCE_CACHE_TTL_MS=21600000

APP_BRAND_NAME=ArenaPredict
APP_DEMO_ENABLED=true
# Jornada guiada /demo: requer APP_DEMO_ENABLED e VITE_DEMO_MODE habilitados.
APP_DEMO_CONTROLLED_ENABLED=true
APP_DEMO_ROUND_WINDOW_HOURS=24
APP_DEMO_LIVE_TIMEOUT_MINUTES=15
APP_DEMO_MAINTENANCE_MS=60000
APP_DEMO_ADMIN_EMAIL=admin@arenapredict.com
APP_DEMO_PARTICIPANT_EMAIL=jogador@arenapredict.com
# Segredos opcionais: defina somente no .env não versionado/Secrets Manager.
# Vazios preservam credenciais existentes; em banco novo, o seed gera senhas aleatórias.
APP_DEMO_ADMIN_PASSWORD=
APP_DEMO_PARTICIPANT_PASSWORD=
# A jornada controlada usa ações explícitas, sem o gerador legado de placar Demo.
APP_DEMO_LIVE_PROVIDER_ENABLED=false
APP_DEMO_LIVE_SCHEDULER_ENABLED=false
APP_DEMO_LIVE_REFRESH_MS=30000
APP_DEMO_LIVE_INITIAL_DELAY_MS=30000
APP_DEMO_SCHEDULE_REFRESH_MS=300000
APP_DEMO_SCHEDULE_INITIAL_DELAY_MS=10000
APP_DEMO_HISTORY_REFRESH_MS=21600000
APP_DEMO_HISTORY_INITIAL_DELAY_MS=60000

POSTGRES_DB=bolao_copa
POSTGRES_USER=bolao
# Gere no ambiente local; nunca reutilize este valor em produção.
POSTGRES_PASSWORD=
POSTGRES_VOLUME_NAME=arenapredict_postgres_data
POSTGRES_HOST_PORT=5433
# Seguro por padrão: altere para 0.0.0.0 somente se precisar acessar de outro dispositivo na rede.
APP_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Em produção, substitua a linha acima pelo origin HTTPS publicado, sem barra final.
# Exemplo deste projeto: CORS_ALLOWED_ORIGINS=https://arena-predict.18-231-73-103.sslip.io
# Gere um segredo aleatório com pelo menos 32 bytes e mantenha-o fora do Git.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

VITE_APP_NAME=ArenaPredict
VITE_APP_SHORT_NAME=Arena
VITE_APP_TAGLINE=Sua leitura. Sua arena.
VITE_APP_DESCRIPTION=Previsões esportivas, bolões e ligas com pontos exclusivamente virtuais.
VITE_APP_STORAGE_NAMESPACE=arena-predict
VITE_SUPPORT_EMAIL=suporte@arenapredict.com
VITE_DEMO_MODE=true
VITE_API_URL=/api
VITE_BACKEND_PROXY=http://localhost:8080
VITE_API_TIMEOUT_MS=12000

# Somente para executar o backend fora do Compose:
# DB_URL=jdbc:postgresql://localhost:5433/bolao_copa
# DB_USERNAME=bolao
# DB_PASSWORD=
